{
  "name": "joplo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "joplo": "tsx packages/cli/src/bin.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web:dev": "pnpm --filter @joplo-app/web dev",
    "web:build": "pnpm --filter @joplo-app/web build",
    "web:serve": "tsx packages/server/scripts/serve.ts",
    "docs:screenshots": "tsx packages/server/scripts/render-docs.ts",
    "skills:build": "tsx scripts/build-skills.ts",
    "build:packages": "pnpm -r --filter \"./packages/*\" --filter \"./plugins/diagram\" run build",
    "release:version": "node scripts/release.mjs version",
    "release:pack": "node scripts/release.mjs pack",
    "release:smoke": "node scripts/release.mjs smoke",
    "release:publish": "node scripts/release.mjs publish",
    "release:verify": "node scripts/release.mjs verify"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "@joplo-app/kit": "workspace:*",
    "@joplo-app/core": "workspace:*"
  }
}
