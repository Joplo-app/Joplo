    "./shared-modules.json": "./shared-modules.json"
  },
  "files": [
    "dist",
    "shared-modules.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-dist.mjs",
    "prepublishOnly": "node scripts/build-dist.mjs",
