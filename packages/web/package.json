  },
  "devDependencies": {
    "@joplo-app/core": "workspace:*",
    "@joplo-app/kit": "workspace:*",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "clsx": "2.1.1",
    "lucide-react": "1.66.0",
    "modern-screenshot": "^4.7.0",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "roughjs": "4.6.6",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "@joplo-app/plugin-diagram": "workspace:*",
    "@joplo-app/plugin-content": "workspace:*",
    "@joplo-app/plugin-ui": "workspace:*"
