{
  "name": "@joplo-app/cli",
  "version": "0.2.11",
  "description": "Joplo 命令实现（init / dev / check / build / render / selection）；通常经由 joplo 命令入口使用",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "joplo-cli": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/cli.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepublishOnly": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@joplo-app/core": "workspace:*",
    "@joplo-app/server": "workspace:*",
    "commander": "^15.0.0",
    "tsx": "4.23.15"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "joplo-cli": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/cli.d.ts",
        "default": "./dist/cli.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joplo-app/Joplo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Joplo-app/Joplo#readme",
  "bugs": {
    "url": "https://github.com/Joplo-app/Joplo/issues"
  }
}
