{
  "name": "@joplo-app/core",
  "version": "0.2.18",
  "description": "Joplo \u7f16\u8bd1\u5668\u3001\u6821\u9a8c\u5668\u4e0e\u64ad\u653e\u5668\uff08IR v2\uff09",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json",
    "./runtime": "./src/runtime.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepublishOnly": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@joplo-app/kit": "workspace:*",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./package.json": "./package.json",
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joplo-app/Joplo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Joplo-app/Joplo#readme",
  "bugs": {
    "url": "https://github.com/Joplo-app/Joplo/issues"
  }
}
