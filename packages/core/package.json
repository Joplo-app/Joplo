{
  "name": "@joplo-app/core",
  "version": "0.7.3",
  "description": "Joplo 作品引擎：编译、校验与确定性播放，支持独立作品和功能方案评审",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./package.json": "./package.json",
    "./runtime": "./src/runtime.ts",
    "./schema": "./src/schema.ts",
    "./features": "./src/features.ts",
    "./catalog": "./src/catalog.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepublishOnly": "node ../../scripts/build-package.mjs"
  },
  "dependencies": {
    "@joplo-app/kit": "workspace:*",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./package.json": "./package.json",
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "./features": {
        "types": "./dist/features.d.ts",
        "default": "./dist/features.js"
      },
      "./catalog": {
        "types": "./dist/catalog.d.ts",
        "default": "./dist/catalog.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joplo-app/Joplo.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Joplo-app/Joplo#readme",
  "bugs": {
    "url": "https://github.com/Joplo-app/Joplo/issues"
  }
}
