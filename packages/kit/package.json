{
  "name": "@joplo-app/kit",
  "version": "0.8.0",
  "description": "Joplo 创作 SDK：用 work、切片与步骤编写可播放、可上手体验的作品；功能评审为作品添加方案比较、情况与规则；含 JSX 运行时（收集为数据，不作为 React 执行）",
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./node": "./src/node.ts",
    "./plugin": "./src/plugin.ts",
    "./package.json": "./package.json",
    "./renderer": "./src/renderer.ts",
    "./renderer-internal": "./src/renderer-internal.ts",
    "./renderer-style": "./src/renderer-style.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepublishOnly": "node ../../scripts/build-package.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./jsx-runtime": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "./jsx-dev-runtime": {
        "types": "./dist/jsx-dev-runtime.d.ts",
        "default": "./dist/jsx-dev-runtime.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "./plugin": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "./package.json": "./package.json",
      "./renderer": {
        "types": "./dist/renderer.d.ts",
        "default": "./dist/renderer.js"
      },
      "./renderer-internal": {
        "types": "./dist/renderer-internal.d.ts",
        "default": "./dist/renderer-internal.js"
      },
      "./renderer-style": {
        "types": "./dist/renderer-style.d.ts",
        "default": "./dist/renderer-style.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joplo-app/Joplo.git",
    "directory": "packages/kit"
  },
  "homepage": "https://github.com/Joplo-app/Joplo#readme",
  "bugs": {
    "url": "https://github.com/Joplo-app/Joplo/issues"
  },
  "devDependencies": {
    "@types/react": "^19.3.0"
  }
}
