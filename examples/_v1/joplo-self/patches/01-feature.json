        "goal": "打开一个方案时，被演示的原型占据画面主体；场景、情况、规则和检查器按需出现，但可追溯性不能丢",
        "roles": [
          "驱动 Agent 的开发者（审阅者本人）",
          "会议旁听者"
        ],
        "constraints": [
          {
            "id": "con_trace",
            "text": "从任一元素，一步之内仍能看到它关联的规则与情况（PRD 1.2）",
            "hard": true
          },
          {
            "id": "con_mode",
            "text": "审阅 / 演示模式始终清楚可辨（PRD 4.4）",
            "hard": true
          },
          {
            "id": "con_concept",
            "text": "“概念原型 · 非正式实现”标识常驻",
            "hard": true
          },
          {
            "id": "con_gaps",
            "text": "缺失与待决定的情况不能被藏到无法发现（PRD 6.2）",
            "hard": true
          }
        ],
        "caseIds": [
          "case_first_look",
          "case_find_gap",
          "case_point",
          "case_rule_of_step",
          "case_meeting",
          "case_small_window"
        ],
        "optionIds": [],
        "dependsOn": []
      }
    },
    {
      "op": "upsertCase",
      "value": {
