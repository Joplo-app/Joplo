                                    "e": "chen.chen@example.com",
                                    "r": "编辑者"
                                  }
                                ]
                              }
                            },
                            {
                              "id": "an_stage_hint",
                              "type": "Text",
                              "props": {
                                "text": "（这一块就是被演示的原型，默认应占工作区的大部分宽度）",
                                "tone": "muted"
                              }
                            }
                          ]
                        }
                      ],
                      "when": {
                        "falsy": "ui.gapView"
                      }
                    },
                    {
                      "id": "an_note",
                      "type": "Card",
                      "props": {
                        "title": "① 规则详情"
                      },
                      "children": [
                        {
                          "id": "an_note_t",
                          "type": "Text",
                          "props": {
                            "text": "规则：只有空间管理员可以发起邀请",
                            "tone": "default"
                          }
                        },
                        {
                          "id": "an_note_badge",
                          "type": "Badge",
                          "props": {
                            "text": "用户 · 已确认",
                            "tone": "success"
                          }
                        },
                        {
                          "id": "an_note_case",
                          "type": "Text",
                          "props": {
                            "text": "关联情况：非管理员尝试邀请",
                            "tone": "muted"
                          }
                        },
                        {
                          "id": "an_btn_copy",
                          "type": "Button",
                          "props": {
                            "label": "复制引用给 Agent",
                            "variant": "secondary"
                          }
                        }
                      ],
                      "when": {
                        "truthy": "ui.noteOpen"
                      }
                    },
                    {
                      "id": "an_gap_empty",
                      "type": "EmptyState",
                      "props": {
                        "title": "这个情况还没有设计",
                        "text": "邮箱为空或格式无效 · 当前方案还没有对应场景"
                      },
                      "when": {
                        "truthy": "ui.gapView"
                      }
                    },
                    {
                      "id": "an_btn_ask",
                      "type": "Button",
                      "props": {
                        "label": "选中这个缺口，让 Agent 补上",
                        "variant": "primary"
                      },
                      "when": {
                        "truthy": "ui.gapView"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "an_stepbar",
              "type": "Stack",
              "props": {
                "direction": "row",
                "gap": 10,
                "align": "center"
              },
              "children": [
                {
                  "id": "an_btn_play",
                  "type": "Button",
                  "props": {
                    "label": "▶ 自动播放",
                    "variant": "primary"
                  }
                },
                {
                  "id": "an_btn_next",
                  "type": "Button",
                  "props": {
                    "label": "下一步",
                    "variant": "secondary"
                  },
                  "unmodeled": true
                },
                {
                  "id": "an_caption",
                  "type": "Text",
                  "props": {
                    "text": "$ui.caption",
                    "tone": "muted"
                  }
                }
              ]
            }
          ]
        }
      }
    }
  ]
}