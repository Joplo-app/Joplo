{
  "name": "@joplo-app/plugin-alda",
  "version": "0.6.0",
  "type": "module",
  "joplo": {
    "api": 2
  },
  "exports": {
    ".": "./src/index.ts",
    "./local": "./src/local.ts",
    "./runtime": "./src/runtime.ts",
    "./guide": "./src/guide.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@joplo-app/kit": "workspace:*",
    "libflacjs": "5.6.0",
    "mpg123-decoder": "1.0.3",
    "spessasynth_core": "4.4.9",
    "stb-vorbis": "0.0.7"
  },
  "description": "Joplo optional text-authored background music and offline SoundFont audio rendering",
  "license": "PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joplo-app/Joplo.git",
    "directory": "plugins/alda"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepublishOnly": "node ../../scripts/build-package.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./local": {
        "types": "./dist/local.d.ts",
        "default": "./dist/local.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./guide": {
        "types": "./dist/guide.d.ts",
        "default": "./dist/guide.js"
      },
      "./package.json": "./package.json"
    }
  }
}
