{
  "name": "@joplo-app/plugin-av",
  "version": "0.7.1",
  "type": "module",
  "joplo": {
    "api": 2
  },
  "exports": {
    ".": "./src/plugin.ts",
    "./runtime": "./src/runtime.tsx",
    "./guide": "./src/guide.ts",
    "./package.json": "./package.json",
    "./local": "./src/local.ts"
  },
  "dependencies": {
    "@joplo-app/kit": "workspace:*",
    "lottie-web": "5.13.0",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0"
  },
  "description": "Joplo video, Lottie and local one-shot sound effects on the engine clock",
  "license": "PolyForm-Shield-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joplo-app/Joplo.git",
    "directory": "plugins/av"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepublishOnly": "node ../../scripts/build-package.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./guide": {
        "types": "./dist/guide.d.ts",
        "default": "./dist/guide.js"
      },
      "./package.json": "./package.json",
      "./local": {
        "types": "./dist/local.d.ts",
        "default": "./dist/local.js"
      }
    }
  }
}
