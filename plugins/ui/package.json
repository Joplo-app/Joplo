{
  "name": "@joplo-app/plugin-ui",
  "version": "0.2.18",
  "type": "module",
  "joplo": {
    "api": 2
  },
  "exports": {
    ".": "./src/plugin.ts",
    "./runtime": "./src/runtime.tsx",
    "./guide": "./src/guide.ts",
    "./package.json": "./package.json",
    "./catalog": "./src/catalog.ts"
  },
  "dependencies": {
    "@joplo-app/kit": "workspace:*",
    "react": "19.3.1",
    "motion": "14.9.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "description": "Joplo first-party UI and HTML vocabulary",
  "license": "PolyForm-Shield-1.0.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepublishOnly": "node ../../scripts/build-package.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./guide": {
        "types": "./dist/guide.d.ts",
        "default": "./dist/guide.js"
      },
      "./package.json": "./package.json",
      "./catalog": {
        "types": "./dist/catalog.d.ts",
        "default": "./dist/catalog.js"
      }
    }
  }
}
