{
  "name": "@joplo-app/plugin-viz",
  "version": "0.9.0",
  "type": "module",
  "joplo": {
    "api": 2
  },
  "exports": {
    ".": "./src/plugin.ts",
    "./effects": "./src/effects.ts",
    "./runtime": "./src/runtime.tsx",
    "./schema": "./src/schema.ts",
    "./catalog": "./src/catalog.ts",
    "./guide": "./src/guide.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@joplo-app/kit": "workspace:*",
    "d3-array": "^3.2.4",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-sankey": "^0.12.4",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/react": "^19.3.0"
  },
  "description": "Joplo first-party narrative data visualization plugin: DeltaBar, BarChart, RatioBar, LineChart, TimeLanes, ScatterPlot, Heatmap, Sankey, Waterfall and Radar",
  "license": "PolyForm-Shield-1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Joplo-app/Joplo.git",
    "directory": "plugins/viz"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepublishOnly": "node ../../scripts/build-package.mjs"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/plugin.d.ts",
        "default": "./dist/plugin.js"
      },
      "./effects": {
        "types": "./dist/effects.d.ts",
        "default": "./dist/effects.js"
      },
      "./runtime": {
        "types": "./dist/runtime.d.ts",
        "default": "./dist/runtime.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      },
      "./catalog": {
        "types": "./dist/catalog.d.ts",
        "default": "./dist/catalog.js"
      },
      "./guide": {
        "types": "./dist/guide.d.ts",
        "default": "./dist/guide.js"
      },
      "./package.json": "./package.json"
    }
  }
}
